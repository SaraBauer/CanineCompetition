@page "/"
@using Blazorise
@using Blazorise.DataGrid
@using CanineCompetition.Data
@inject AppDbContext Db

<script>
   .confirm-modal .modal-dialog {
        max-width: 350px !important;
   }
    .my-delete-modal .modal-dialog {
        max-width: 400px !important;
    }
        .container {
      display: flex;
      
    }
</script>

<h3>Selected entry: </h3>
@if(selectedEntry != null)
{
    <h2>@selectedEntry.Name, @selectedEntry.Duration</h2>
}

<Modal @ref="deleteModal" Centered Background="Background.Dark" Style="max-width:250px!important; max-height: 250px!important" TextColor="TextColor.White">
    <ModalHeader>
        <h5 class="modal-title">Delete Entry</h5>
    </ModalHeader>

    <ModalBody>
        <p>Are you sure you want to delete <strong>@selectedEntry?.Name</strong>?</p>
    </ModalBody>

    <ModalFooter>
        <Button Color="Color.Secondary" Outline="true" Clicked="CancelDelete">
            Cancel
        </Button>
        <Button Color="Color.Danger" Clicked="ConfirmDelete">
            Delete
        </Button>
    </ModalFooter>
</Modal>
<div style="display:@showNewEntryField">
    <div style="display:flex;flex-wrap: wrap; padding:5px">
        <div class="item" style="max-width:250px; padding-right:10px">
            <Input Placeholder="Enter name" @bind-Value="@newEntry.Name"/>
        </div>
        <div class="item" style="padding-right:10px">
            <DurationPicker Value="@newEntry.Duration" ValueChanged="@UpdateTimeSpanNewEntry" />

        </div>
        <div class="item" >
            <Button Color="Color.Primary" Clicked="@SaveNewEntry">Save</Button>
      
            <Button Color="Color.Secondary" Clicked="@SaveNewEntry">Cancel</Button>
        </div>
    </div>
</div>

<DataGrid TItem="DurationEntry"
          Data="@items"
          @ref="grid"
          @bind-SelectedRow="@selectedEntry"
          Editable = "true"
          Responsive
          ShowPager
          CommandMode="DataGridCommandMode.ButtonRow"
          EditMode="DataGridEditMode.Inline">
    <DataGridColumns>
        <DataGridCommandColumn NewCommandAllowed="true" EditCommandAllowed="true" DeleteCommandAllowed="false" CancelCommandAllowed>
            <NewCommandTemplate>
                <Button Color="Color.Success" Clicked="@NewEntry">
                    New
                </Button>
            </NewCommandTemplate>
            <SaveCommandTemplate>
                <Button ElementId="btnSave" Type="ButtonType.Submit" PreventDefaultOnSubmit Color="Color.Primary" Clicked="@SaveSelected">@context.LocalizationString</Button>
            </SaveCommandTemplate>
            <CancelCommandTemplate>
                <Button ElementId="btnCancel" Color="Color.Secondary" Clicked="@context.Clicked">@context.LocalizationString</Button>
            </CancelCommandTemplate>
        </DataGridCommandColumn>
        <DataGridColumn Field="@nameof(DurationEntry.Name)" Caption="Name" Editable >
            <EditTemplate>
                @{
                    var currentName = context.Item.Name;
                }
                <TextInput Placeholder="Enter name" Value="@currentName" ValueChanged="@(value=> UpdateName(value))" />
            </EditTemplate>
            </DataGridColumn>

        <DataGridColumn TItem="DurationEntry" Field = "@nameof(DurationEntry.Duration)" Caption="Duration" Editable >
            <DisplayTemplate>
                @FormatTimeSpan(context.Item.Duration)
        </DisplayTemplate>
     <EditTemplate>
                @{
                    var currentDuration = context.Item.Duration;
                }
                <DurationPicker Value="@currentDuration" ValueChanged="@UpdateTimeSpan" />
</EditTemplate>

</DataGridColumn>


    </DataGridColumns>

    <ButtonRowTemplate>
        <Button Color="Color.Primary" Disabled="( selectedEntry is null )" Clicked="context.EditCommand.Clicked">Edit</Button>
        <Button Color="Color.Danger" Disabled="(selectedEntry is null)" Clicked="() => AskDelete()">Delete</Button>
    </ButtonRowTemplate>
</DataGrid>

<button class="sw-btn sw-save" @onclick="ShowSortedResults">
    Show Results 🐾
</button>
@if (ShowResults)
{
    int i = 1;
    <div>
     <div class="card-dog" style="width:auto">
            <div> MIN: @minEntry.Name, @minEntry.Duration.ToString(@"mm\:ss\:fff")</div>
            <div> MAX: @maxEntry.Name, @maxEntry.Duration.ToString(@"mm\:ss\:fff")</div>
            <div>  AVERAGE: @average.ToString(@"mm\:ss\:fff")</div>
        </div>
    @foreach (var item in sorted)
        {
            <div class="card-dog" style="width:auto">
                <div> @i - @item.Name: @item.Duration.ToString(@"mm\:ss\:fff")</div>
            </div>
            i++;
        }
    </div>
}

@code {
    private List<DurationEntry> items = new(){};
    private DataGrid<DurationEntry> grid;
    private string changedDurationString = "";
    private DurationEntry selectedEntry;
    private string showNewEntryField = "none";

    DurationEntry minEntry;
    DurationEntry maxEntry;
    TimeSpan average;
    private bool ShowResults = false;
    private List<DurationEntry> sorted = new();

    public DurationEntry newEntry = new DurationEntry();
    protected override async Task OnInitializedAsync()
    {
        items = await Db.GetAlltriesAsync();
    }



    private void UpdateName(string newName)
    {
        if (selectedEntry != null)
        {
            selectedEntry.Name = newName;
        } 
    }

    public async Task UpdateTimeSpan(TimeSpan newValue)
    {
        if (selectedEntry != null)
        {
            selectedEntry.Duration = newValue;
        } 

    }

    public void NewEntry()
    {
        newEntry = new DurationEntry();
        showNewEntryField = "";
    }

    public async Task UpdateTimeSpanNewEntry(TimeSpan newValue)
    {
        if (newEntry != null)
        {
            newEntry.Duration = newValue;
        }
    }

    private string FormatTimeSpan(object value)
    {
        if (value is TimeSpan ts)
            return ts.ToString(@"mm\:ss\:fff");

        return string.Empty;
    }
    private async Task SaveSelected()
    {
        if (selectedEntry is null)
            return;

        if (selectedEntry.Id == 0)
            Db.DurationEntries.Add(selectedEntry);
        else
            Db.DurationEntries.Update(selectedEntry);
        await Db.SaveChangesAsync();

        await grid.Cancel();
        await grid.Reload();
    }

    private async Task SaveNewEntry()
    {
        if (newEntry is null)
            return;

        if (newEntry.Id == 0)
            Db.DurationEntries.Add(newEntry);
        else
            Db.DurationEntries.Update(newEntry);
        await Db.SaveChangesAsync();

        await grid.Cancel();
        await grid.Reload();
        showNewEntryField = "none";

        items = await Db.GetAlltriesAsync();
    }


    private async Task CancelNewEntry()
    {
        newEntry = new DurationEntry();


    }

    private Modal deleteModal;


    private async Task AskDelete()
    {
        await deleteModal.Show();
    }

    private async Task CancelDelete()
    {
        selectedEntry = null;
        await deleteModal.Hide();
    }

    private async Task ShowSortedResults()
    {
        //1. get min and max values from db
        minEntry = items.OrderBy(x => x.Duration).First();
        maxEntry = items.OrderBy(x => x.Duration).Last();
        average = new TimeSpan((minEntry.Duration.Ticks + maxEntry.Duration.Ticks) / 2);
        sorted = items
            .OrderBy(r => Math.Abs((r.Duration - average).Ticks))
            .ToList();

        ShowResults = true;
    }

    private async Task ConfirmDelete()
    {
        if (selectedEntry is null)
            return;

        // Remove from EF Core
        Db.Remove(selectedEntry);
        await Db.SaveChangesAsync();

        // Remove from UI list
        items.Remove(selectedEntry);

        // Refresh DataGrid
        await grid.Reload();

        selectedEntry = null;
        await deleteModal.Hide();
    }


}
